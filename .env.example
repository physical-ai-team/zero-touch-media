# 서버 설정. 복사해서 쓴다:  copy .env.example .env
# 값을 하드코딩하지 말고 여기에 키를 추가한다(설명 한 줄 필수, 팀원3 확인).

# --- HTTP / WebSocket 서버 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- MQTT 브로커 (PC에서 실행하는 Mosquitto) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# 모든 토픽의 앞부분. 예: ztmc/cam-1/detect, ztmc/state
MQTT_TOPIC_PREFIX=ztmc

# --- 판정 안정화 (server/ztmc_server/presence.py) ---
# 얼굴이 이 시간(ms) 동안 계속 보여야 present(재생)
FACE_ON_MS=300
# 얼굴이 이 시간(ms) 동안 계속 안 보여야 absent(정지). 잠깐 고개를 돌려도 멈추지 않게 길게.
FACE_OFF_MS=1500
# 서버 쪽 추가 신뢰도 기준. 펌웨어 기준값보다 낮으면 효과 없음
MIN_SCORE=0.6
# 이 시간(ms) 동안 detect가 없으면 no_device(정지 + 끊김 표시)
DEVICE_TIMEOUT_MS=3000

# --- 브라우저 ---
# 브라우저로 보내는 원본 detect 메시지 최대 빈도(Hz)
PLAYER_DETECT_HZ=10
# 시계 맞추기 ping 주기(초)
CLOCK_PING_INTERVAL_SEC=2
# 페이지가 처음 여는 유튜브 영상 ID
DEFAULT_VIDEO_ID=jNQXAC9IVRw

# --- 로그 ---
LOG_LEVEL=INFO
